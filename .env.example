REDIS_URL=redis://localhost:6379

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secreta (salta RLS): solo servidor, nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Sitio: return_url de Webpay y urlReturn/urlConfirmation de Flow (sin / final). Queda fija en el build
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webpay Plus (integración: código y llave oficiales públicos de Transbank)
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# Flow (sandbox: Mis datos → Integraciones)
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Datos bancarios de la transferencia (valores de ejemplo: los reales van solo en .env.local y en Vercel)
BANK_NAME=Banco de Chile
BANK_ACCOUNT_TYPE=Cuenta corriente
BANK_ACCOUNT_NUMBER=00-123-45678-09
BANK_ACCOUNT_HOLDER=Almacén SpA
BANK_ACCOUNT_RUT=76.543.210-3
BANK_ACCOUNT_EMAIL=pagos@almacen.cl

# Cron de vencimiento: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Limpieza de invitados en el mismo cron (7.8, D-033): solo borra con true. Vacía = solo cuenta
ANON_CLEANUP_ENABLED=

# Correo transaccional (Resend). Vacía = los correos se omiten con un aviso en el log
RESEND_API_KEY=
EMAIL_FROM=Almacén <pedidos@mail.audazia.dev>

# Los más vendidos del Inicio (D-032): solo cuenta pedidos pagados desde esta fecha (ISO, p. ej. 2026-11-01T00:00:00-03:00).
# Vacía = el Inicio muestra Destacados. Se lee en el build y en cada revalidación del Inicio: defínela en los dos lados (en Vercel, redespliega al cambiarla)
BEST_SELLERS_SINCE=
